// Exercises every audio command variant.
title: audio_showcase
skip: always
sequence:
	<<music theme_main fade_in:2.0 volume:0.8 loop:true>>
	<<sound door_creak volume:1.0 fade_in:0.1>>
	<<ambient rain_loop fade_in:3.0 volume:0.5>>
	<<voice player vo_player_line1 loc_key:player:0:abc12345>>
	<<ambient stop rain_loop fade_out:2.0>>
	<<music stop fade_out:1.5>>
	<<end>>
