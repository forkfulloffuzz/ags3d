[project]
name = "AGS3D Prototype"
start_room = "rooms/start/start.agroom"
start_character = "characters/player.agchar"

[settings]
rendering_mode = "full_3d"
autosave = "true"

[locale.en]
name = "English"

[locale.fr]
name = "French"

[locale.de]
name = "German"

[localisation]
default_author_locale = "en"
supported_locales = "en fr de"
fallback_chain = "en"

