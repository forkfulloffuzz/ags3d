// All localizable cutscene commands: line, title_card, subtitle, choice.
// Exercises T-CUT30 (cutscene localisation pipeline).
title: scene_loc_keys
voice_session: vs_loc_test
loc_group: loc_group_test
sequence:
	<<title_card "Chapter One: The Beginning" #duration:3.0 #loc:tc_ch1_start>>
	<<subtitle "The sun rose over the city." #loc:sub_sun_rise>>
	<<line narrator "It was a cold morning." #loc:line_cold_morning>>
	<<line player "I can't believe it's already here." #loc:line_player_arrival>>
	<<choice "Ask about the city." #loc:choice_ask_city>>
	<<choice "Ignore and move on." #loc:choice_ignore>>
	<<fade_out #duration:1.0>>
	<<end>>
