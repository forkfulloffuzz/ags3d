; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="AGS3D Prototype"
run/main_scene="res://rooms/start/start.tscn"
config/features=PackedStringArray("4.7")

[autoload]

AGSRuntime="*res://.engine/runtime/ags_runtime.gd"
AGSSaveLoad="*res://.engine/runtime/ags_save_load.gd"
AGSAudio="*res://.engine/runtime/ags_audio.gd"
player="*res://characters/player.tscn"
AGSRoomManager="*res://.engine/runtime/ags_room_manager.gd"

[editor_plugins]

enabled=PackedStringArray()
