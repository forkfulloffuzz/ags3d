// 08_loops.agscript
// while, do..while, for — including all optional parts of for header.
// break and continue inside each loop form.

function testWhile() {
    int i = 0;
    while (i < 10) {
        i++;
    }
}

function testWhileWithBreak() {
    int i = 0;
    while (true) {
        if (i >= 5) {
            break;
        }
        i++;
    }
}

function testWhileWithContinue() {
    int i = 0;
    while (i < 10) {
        i++;
        if (i % 2 == 0) {
            continue;
        }
        // only odd values reach here
    }
}

function testDoWhile() {
    int i = 0;
    do {
        i++;
    } while (i < 5);
}

function testDoWhileExecutesOnce() {
    // Body always executes at least once even if condition is false
    int x = 0;
    do {
        x = 99;
    } while (false);
    // x == 99 here
}

function testForBasic() {
    for (int i = 0; i < 10; i++) {
        // basic counted loop
    }
}

function testForCountDown() {
    for (int i = 10; i > 0; i--) {
        // countdown
    }
}

function testForCompoundPost() {
    for (int i = 0; i < 100; i += 5) {
        // step by 5
    }
}

function testForBreak() {
    for (int i = 0; i < 100; i++) {
        if (i == 42) {
            break;
        }
    }
}

function testForContinue() {
    for (int i = 0; i < 10; i++) {
        if (i % 2 == 0) {
            continue;
        }
        // odd only
    }
}

function testForNoInit() {
    int i = 0;
    for (; i < 5; i++) {
        // init omitted
    }
}

function testForNoPost() {
    for (int i = 0; i < 5;) {
        i += 2; // post omitted, update in body
    }
}

function testForNoCondition() {
    // Infinite loop with break inside
    for (int i = 0;; i++) {
        if (i > 9) break;
    }
}

function testNestedLoops() {
    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 3; j++) {
            if (i == j) {
                continue; // continues inner loop
            }
        }
    }
}
