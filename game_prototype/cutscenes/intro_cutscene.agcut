title: intro_cutscene
language: en
voice_session: vs_intro
loc_group: act1
sequence:
	<<fade_in #duration:1.5>>
	<<title_card "The Market District" #duration:3.0 #loc:tc_intro_market>>
	<<subtitle "Three years. And it still felt foreign." #loc:sub_intro_narrator>>
	<<line narrator "The city gates stood open, as always." #loc:line_intro_gate>>
	<<line guard "Halt! Who goes there?" #loc:line_intro_guard_challenge>>
	<<line player "It's me. Just a traveler." #loc:line_intro_player_response>>
	<<choice "I'm looking for the merchant." #loc:choice_intro_merchant>>
	<<choice "I'm just passing through." #loc:choice_intro_passing>>
	<<fade_out #duration:1.0>>
	<<end>>
